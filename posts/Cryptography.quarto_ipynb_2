        "        ax.set_xlabel('$x$')\n",
        "        ax.set_ylabel('$f$')\n",
        "\n",
        "       \n",
        "        a_vec=np.linspace(0,p-1,p,dtype=int)\n",
        "        \n",
        "        function_mod=(g**a_vec)%p\n",
        "        ax.plot(a_vec,function_mod,'x',a_vec,np.ones_like(a_vec)*s,'r--')\n",
        "\n",
